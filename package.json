    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "cypress-axe": {
      "cypress": "$cypress"
    },
    "dompurify": "$dompurify",
    "fast-uri": "4.2.1",
    "glob": "$glob",
