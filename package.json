    "@types/intro.js": "5.1.5",
    "@types/js-cookie": "3.0.6",
    "@types/lodash": "4.17.25",
    "@types/node": "24.19.1",
    "@types/prismjs": "1.26.6",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "cypress": "16.1.0",
